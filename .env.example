# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub App ──────────────────────────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_TOKEN=ghp_...                        # PAT for repo dispatch / issue creation

# ── Monitored repos (org/repo format) ───────────────────────────────────────
CODESENSE_REPO=DadaMastan-code/codesense-ai
MEDFUSION_REPO=DadaMastan-code/MedFusion-Leuk
MEDBRAIN_REPO=DadaMastan-code/medbrain-ai
NEXUS_REPO=DadaMastan-code/omnimed-nexus

# ── Downstream service URLs ──────────────────────────────────────────────────
CODESENSE_API_URL=http://localhost:8001
MEDFUSION_API_URL=http://localhost:8002
MEDBRAIN_API_URL=http://localhost:8003

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                             # leave blank for local

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omnimed-nexus

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=omnimed-nexus

# ── Postgres (MLflow backend) ─────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
